{
	"name": "hexagonal-saas-template",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"start:dev": "bun --watch src/index.ts",
		"build": "bun run tsc -p tsconfig.json",
		"start": "bun dist/index.js",
		"start:prod": "bun dist/index.js",
		"lint": "bun run eslint src --ext .ts",
		"lint:fix": "bun run eslint src --ext .ts --fix",
		"prisma:generate:master": "bun run --env-file=.env prisma generate --schema=prisma/prisma-master.schema.prisma",
		"prisma:generate:business": "bun run --env-file=.env prisma generate --schema=prisma/prisma-business.schema.prisma",
		"prisma:generate:all": "bun run prisma:generate:master && bun run prisma:generate:business",
		"prisma:push:master": "bun run --env-file=.env prisma db push --schema=prisma/prisma-master.schema.prisma",
		"prisma:push:business": "bun run --env-file=.env prisma db push --schema=prisma/prisma-business.schema.prisma",
		"prisma:push:all": "bun run prisma:push:master && bun run prisma:push:business",
		"prisma:studio:master": "bun run --env-file=.env prisma studio --schema=prisma/prisma-master.schema.prisma",
		"prisma:studio:business": "bun run --env-file=.env prisma studio --schema=prisma/prisma-business.schema.prisma",
		"prisma:seed": "bun run --env-file=.env prisma/seed.ts",
		"test": "bun test ./tests/**/*.test.ts --coverage"
	},
	"author": "",
	"license": "ISC",
	"description": "Multi-tenant SaaS REST API template with Hexagonal Architecture",
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.10.5",
		"@types/pg": "^8.11.6",
		"@typescript-eslint/eslint-plugin": "^8.19.0",
		"@typescript-eslint/parser": "^8.19.0",
		"eslint": "^9.17.0",
		"prisma": "^7.3.0",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.19.0"
	},
	"dependencies": {
		"@prisma/client": "^7.3.0",
		"bcrypt-ts": "^7.1.0",
		"body-parser": "^2.2.0",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"helmet": "^8.0.0",
		"jsonwebtoken": "^9.0.2",
		"pg": "^8.14.1",
		"winston": "^3.18.3",
		"winston-daily-rotate-file": "^5.0.0",
		"zod": "^4.1.12"
	}
}
