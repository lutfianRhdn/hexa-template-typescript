{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"lib": ["ES2022"],
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"moduleResolution": "node",
		"baseUrl": ".",
		"paths": {
			"@core/*": ["src/core/*"],
			"@adapters/*": ["src/adapters/*"],
			"@transports/*": ["src/transports/*"],
			"@configs/*": ["src/configs/*"],
			"@utils/*": ["src/utils/*"],
			"@mappers/*": ["src/mappers/*"],
			"@policies/*": ["src/policies/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "tests"]
}
