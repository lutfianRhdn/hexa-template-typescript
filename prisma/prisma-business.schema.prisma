// =============================================================
// prisma/prisma-business.schema.prisma
// Tier   : TENANT (template — identical structure for all tenants)
// Schema : Dynamic — tenant_{8hex}
//          Resolved at runtime via schema interception
// =============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/business-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["tenant_template"]
}

// ──────────────────── USERS ────────────────────

model User {
  id          String    @id @default(cuid())
  name        String
  username    String    @unique
  password    String
  role        String    @default("USER")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([username])
  @@index([role])
  @@map("users")
  @@schema("tenant_template")
}

// ──────────────────── PROFILE ────────────────────

model Profile {
  id        String   @id @default(cuid())
  name      String
  tagline   String?
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
  @@schema("tenant_template")
}

// ──────────────────── SETTINGS ────────────────────

model Setting {
  id        String   @id @default(cuid())
  group     String
  key       String
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, key])
  @@index([group])
  @@map("settings")
  @@schema("tenant_template")
}
