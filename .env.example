# Application
APP_NAME=my-api
APP_ENV=development
APP_DEBUG=true
APP_KEY=base64:change-this-secret-key

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb

# Redis (optional)
ADAPTER_REDIS_HOST=localhost
ADAPTER_REDIS_PORT=6379

# HTTP
TRANSPORT_HTTP_PORT=8080

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
